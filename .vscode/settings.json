{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.validate": ["javascript", "typescript", "vue"],
  "cSpell.words": [
    "Aleksandr",
    "ianvs",
    "iface",
    "maxlength",
    "Uids",
    "Vite",
    "vitepress",
    "автофокусом",
    "валидируемая",
    "валидируемого",
    "деструктуризации",
    "одностраничных"
  ],

  "tailwindCSS.classAttributes": ["class", "className", "ngClass", "classes", "ui"],
  "tailwindCSS.experimental.classRegex": [
    ["classes:\\s*{([^)]*)\\s*}", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["ui:\\s*{([^)]*)\\s*}", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ]
}
